from database.base import Base
import uuid
from sqlalchemy import Column, Integer, String, Float, DateTime, Column, String, Float, DateTime
"""
Unified SQLAlchemy Base for all models.

This file only defines Base.
Other objects (engine, SessionLocal, get_db, init_db) are in database/config.py.

Usage:
    from database.models import Base           # only Base
    from database.config import engine, get_db  # session management
    from .base import Base, engine, get_db   # facade (backward compat)
"""

from sqlalchemy.orm import declarative_base
from datetime import datetime, timezone
from sqlalchemy import Column, String, Boolean, DateTime
from .base import Base
from datetime import datetime

Base = declarative_base()


class LandProfileDB(Base):
    """جدول land_profiles برای رفع ForeignKey"""
    __tablename__ = 'land_profiles'

    id = Column(String, primary_key=True, default=lambda: str(uuid.uuid4()))
    name = Column(String)
    location_lat = Column(Float)
    location_lon = Column(Float)
    area_ha = Column(Float, nullable=True)
    created_at = Column(DateTime, default=lambda: datetime.now(timezone.utc))

    # روابط در صورت نیاز
    # nojin_application_plans = relationship("NojinApplicationPlan", back_populates="land_profile")

# Re-export User for compatibility


# Re-export User for backward compatibility (safe import)
try:
    from database.models import User
except ImportError:
    pass

class User(Base):
    """مدل کاربر سیستم"""
    __tablename__ = "users"

    id = Column(String, primary_key=True, default=lambda: str(uuid.uuid4()))
    email = Column(String, unique=True, index=True, nullable=False)
    hashed_password = Column(String)
    password_hash = Column(String, nullable=True)
    full_name = Column(String, nullable=True)
    role = Column(String, nullable=False, default="user")
    is_active = Column(Boolean, default=True)
    is_verified = Column(Boolean, default=False)
    created_at = Column(DateTime, default=lambda: datetime.now(timezone.utc))
    updated_at = Column(DateTime, default=lambda: datetime.now(timezone.utc), onupdate=lambda: datetime.now(timezone.utc))

    def __repr__(self):
        return f"<User {self.email}>"



