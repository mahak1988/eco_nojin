"""
database.hub.hub
================
هاب مرکزی داده - نقطه دسترسی یکپارچه

معماری:
    همه سرویس‌ها → هاب مرکزی → منابع داده
    
مزایا:
    - نقطه دسترسی واحد
    - مدیریت اتصال مرکزی
    - کش یکپارچه
    - لاگ مرکزی
"""

from typing import Optional, Any
from pathlib import Path
import os


PROJECT_ROOT = Path(__file__).resolve().parents[2]


class DataHub:
    """
    هاب مرکزی داده
    
    این کلاس نقطه دسترسی یکپارچه به همه منابع داده است.
    """
    
    _instance: Optional['DataHub'] = None
    
    def __new__(cls):
        if cls._instance is None:
            cls._instance = super().__new__(cls)
            cls._instance._initialized = False
        return cls._instance
    
    def __init__(self):
        if self._initialized:
            return
        
        self._initialized = True
        self._duckdb_connection = None
        self._sqlalchemy_engine = None
        self._redis_client = None
        
        # مسیرهای داده
        self.data_dir = PROJECT_ROOT / "data"
        self.master_duckdb = self.data_dir / "eco_nojin_master.duckdb"
        self.analytics_duckdb = self.data_dir / "eco_nojin.duckdb"
        self.manual_sqlite = self.data_dir / "manual" / "eco_manual_v1.sqlite"
    
    def get_duckdb(self, database: str = "master") -> Any:
        """
        دریافت اتصال به داک‌دی‌بی
        
        آرگومان‌ها:
            database: "master" برای اصلی، "analytics" برای تحلیلی
        
        بازگشت:
            اتصال داک‌دی‌بی
        """
        try:
            import duckdb
        except ImportError:
            raise ImportError("duckdb is not installed")
        
        if self._duckdb_connection is None:
            if database == "master":
                db_path = self.master_duckdb
            elif database == "analytics":
                db_path = self.analytics_duckdb
            else:
                raise ValueError(f"Unknown database: {database}")
            
            if db_path.exists():
                self._duckdb_connection = duckdb.connect(str(db_path))
            else:
                # ایجاد دیتابیس جدید
                db_path.parent.mkdir(parents=True, exist_ok=True)
                self._duckdb_connection = duckdb.connect(str(db_path))
        
        return self._duckdb_connection
    
    def get_sqlite(self, database: str = "manual") -> Any:
        """
        دریافت اتصال به اس‌کیولایت
        
        آرگومان‌ها:
            database: "manual" برای داده‌های دستی
        
        بازگشت:
            اتصال اس‌کیولایت
        """
        import sqlite3
        
        if database == "manual":
            db_path = self.manual_sqlite
        else:
            raise ValueError(f"Unknown database: {database}")
        
        if db_path.exists():
            return sqlite3.connect(str(db_path))
        else:
            db_path.parent.mkdir(parents=True, exist_ok=True)
            return sqlite3.connect(str(db_path))
    
    def get_sqlalchemy_engine(self) -> Any:
        """
        دریافت موتور اس‌کیوال‌آلکمی
        
        بازگشت:
            موتور اس‌کیوال‌آلکمی
        """
        if self._sqlalchemy_engine is None:
            from sqlalchemy import create_engine
            
            # خواندن تنظیمات از محیط
            database_url = os.environ.get("DATABASE_URL", "sqlite:///data/eco_nojin.db")
            
            self._sqlalchemy_engine = create_engine(
                database_url,
                echo=False,
                pool_pre_ping=True
            )
        
        return self._sqlalchemy_engine
    
    def get_redis(self) -> Any:
        """
        دریافت اتصال به ردیس
        
        بازگشت:
            کلاینت ردیس
        """
        if self._redis_client is None:
            try:
                import redis
                redis_url = os.environ.get("REDIS_URL", "redis://localhost:6379/0")
                self._redis_client = redis.from_url(redis_url)
            except ImportError:
                raise ImportError("redis is not installed")
        
        return self._redis_client
    
    def close_all(self):
        """بستن همه اتصالات"""
        if self._duckdb_connection:
            self._duckdb_connection.close()
            self._duckdb_connection = None
        
        if self._sqlalchemy_engine:
            self._sqlalchemy_engine.dispose()
            self._sqlalchemy_engine = None
        
        if self._redis_client:
            self._redis_client.close()
            self._redis_client = None


# نمونه استفاده
hub = DataHub()
