"""
مدل‌های سرویس احراز هویت
استفاده از Base مشترک از database.base
"""

from sqlalchemy import Column, Integer, DateTime, Column, String, Integer, Float, DateTime, Boolean
from database.base import Base
from datetime import datetime, timezone

# Re-export User از database.models تا یکپارچه باشد
from database.models import User

class AuditLog(Base):
    __tablename__ = "auditlog"

    id = Column(Integer, primary_key=True, autoincrement=False)
    detail = Column(String)
    role = Column(String)
    actor_id = Column(String)
    actor_email = Column(String)
    action = Column(String)
    target = Column(String)
    user_id = Column(String)
    amount = Column(Float)
    token = Column(String)
    created_at = Column(DateTime, default=lambda: datetime.now(timezone.utc))
    is_active = Column(Boolean, default=True)

class EcoWallet(Base):
    __tablename__ = "ecowallet"

    id = Column(Integer, primary_key=True, autoincrement=False)
    user_id = Column(String)
    balance = Column(Float, default=0.0)
    created_at = Column(DateTime, default=lambda: datetime.now(timezone.utc))

class PasswordResetToken(Base):
    __tablename__ = "password_reset_tokens"

    id = Column(Integer, primary_key=True, autoincrement=False)
    user_id = Column(String)
    token = Column(String)
    expires_at = Column(DateTime)
    created_at = Column(DateTime, default=lambda: datetime.now(timezone.utc))


class AIConversation(Base):
    __tablename__ = "aiconversation"

    id = Column(Integer, primary_key=True, autoincrement=False)
    created_at = Column(DateTime, default=lambda: datetime.now(timezone.utc))

    def __repr__(self):
        return f"<AIConversation id={self.id}>"


