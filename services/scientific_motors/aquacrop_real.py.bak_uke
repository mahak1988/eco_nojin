    "BSk": {"factor": 0.11, "wp_adj": 0.82, "hi_adj": 0.92, "heat": 0.08, "ceiling": 10.0},
    "Csa": {"factor": 0.14, "wp_adj": 0.90, "hi_adj": 0.95, "heat": 0.05, "ceiling": 15.0},
}

