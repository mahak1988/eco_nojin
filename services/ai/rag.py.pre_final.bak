# ── singleton ───────────────────────────────────────────────────
index = _IndexSingleton()


def build() -> int:
    """تابع کمکی سازگار با import مستقیم"""
    return index.build()


def search(query: str, top_k: int = 5) -> List[Dict[str, Any]]:
    """تابع کمکی جستجو"""
    return index.search(query, top_k=top_k)
