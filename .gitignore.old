# ============================================================================
# 🚫 NEGATION RULES (Files that SHOULD be committed despite above rules)
# ============================================================================
!.gitignore
!.gitattributes
!README.md
!LICENSE
!CONTRIBUTING.md
!CHANGELOG.md
!.env.example
!.env.template
!data/**/*.example.*
!**/.gitkeep