# ============================================================================
# ECO NOJIN — Global .gitignore
# Standards: PEP 582, Node.js, C++20 (MSVC/GCC/Clang), GIS/Remote Sensing
# Last updated: 2026-08-18
# ============================================================================

# ============================================================================
# 🐍 PYTHON
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.pyi.bak
.Python
*.egg-info/
*.egg
.installed_cfg
MANIFEST
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
ENV/
env/
.venv/Lib/site-packages/__pycache__/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
nosetests.xml
test-results/
*.cover

# Type checking & linting
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json

# Distribution / packaging
.Python
pip-log.txt
pip-delete-this-directory.txt

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Cython
*.c
!engine/cpp_core/**/*.c

# ============================================================================
# 🔒 SECRETS & ENVIRONMENT (NEVER COMMIT)
# ============================================================================
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.key
*.p12
*.pfx
*.keystore
secrets/
credentials/
*.credentials
serviceAccountKey.json

# Allow example files
!.env.example
!.env.template

# ============================================================================
# 🗄️ DATABASES (Binary files NEVER belong in Git)
# ============================================================================
# SQLite
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

# PostgreSQL dumps (too large for Git)
*.dump
*.sql.gz
*.sql.bz2

# DuckDB
*.duckdb
*.duckdb-wal

# Alembic compiled
alembic/versions/*.pyc

# ============================================================================
