"""Integration tests for the Phase 5 admin API (RBAC + audit)."""
from fastapi.testclient import TestClient

from database.models import Base
from database.config import engine
from services.api_gateway.main import app
from database.config import SessionLocal
from database import models

client = TestClient(app)


def setup_function():
    """Reset database before each test."""
    Base.metadata.drop_all(bind=engine)
    Base.metadata.create_all(bind=engine)


def _make_user(email, role="regular", is_active=True):
    from services.api_gateway.auth import hash_password

    db = SessionLocal()
    u = models.User(
        email=email,
        full_name=email.split("@")[0],
        hashed_password=hash_password("testpass123"),
        role=role,
        is_active=is_active,
    )
    db.add(u)
    db.commit()
    db.refresh(u)
    db.close()
    return u.id


def _login(email):
    resp = client.post("/api/v1/auth/login", json={"email": email, "password": "testpass123"})
    assert resp.status_code == 200, resp.text
    return resp.json()["access_token"]


def _auth(token):
    return {"Authorization": f"Bearer {token}"}


def test_admin_health_requires_admin_role():
    _make_user("farmer@test.com", role="farmer")
    token = _login("farmer@test.com")
    resp = client.get("/api/v1/admin/health", headers=_auth(token))
    assert resp.status_code == 403


def test_admin_health_ok_for_admin():
    _make_user("boss@test.com", role="admin")
    token = _login("boss@test.com")
    resp = client.get("/api/v1/admin/health", headers=_auth(token))
    assert resp.status_code == 200
    body = resp.json()
    assert body["status"] in ("ok", "degraded")
    channels = {c["channel"]: c["status"] for c in body["channels"]}
    assert channels["database"] == "ok"
    assert "satellite" in channels
    assert "telegram" in channels


def test_admin_users_list_and_block_flow():
    boss_id = _make_user("boss@test.com", role="admin")
    _make_user("victim@test.com", role="farmer", is_active=True)
    token = _login("boss@test.com")

    # List users
    resp = client.get("/api/v1/admin/users", headers=_auth(token))
    assert resp.status_code == 200
    emails = [u["email"] for u in resp.json()]
    assert "victim@test.com" in emails

    # Block
    victims = [u for u in resp.json() if u["email"] == "victim@test.com"]
    victim_id = victims[0]["id"]
    resp = client.post(f"/api/v1/admin/users/{victim_id}/block", headers=_auth(token))
    assert resp.status_code == 200
    assert resp.json()["success"] is True

    # Blocked user cannot log in anymore
    resp = client.post("/api/v1/auth/login", json={"email": "victim@test.com", "password": "testpass123"})
    assert resp.status_code in (400, 401, 403)

    # Cannot block yourself
    resp = client.post(f"/api/v1/admin/users/{boss_id}/block", headers=_auth(token))
    assert resp.status_code == 400

    # Audit trail exists
    resp = client.get("/api/v1/admin/audit", headers=_auth(token))
    assert resp.status_code == 200
    actions = [a["action"] for a in resp.json()]
    assert "user.block" in actions
