import pytest
from sqlalchemy import create_engine, Table, Column, String
from sqlalchemy.orm import sessionmaker

# ⚙️ ساخت موتور تست و session factory
TEST_ENGINE = create_engine("sqlite:///:memory:", echo=False)
TEST_SESSION_FACTORY = sessionmaker(bind=TEST_ENGINE, autocommit=False, autoflush=False)

# بارگذاری مدل‌ها
from database.base import Base
import database.models
import services.auth.models
import engine.land.models
import engine.hydroma.core.models
import engine.hydroma.biofertilizer.models
import services.landscape.models
import services.marketplace.models
import services.tourism.models
import services.notification.models
import services.ledger.models
import services.reporting.models
import services.workflow.models

# اطمینان از وجود جدول land_profiles
if 'land_profiles' not in Base.metadata.tables:
    Table(
        'land_profiles', Base.metadata,
        Column('id', String, primary_key=True)
    )

# ساخت جداول روی موتور تست
Base.metadata.create_all(bind=TEST_ENGINE)

# جایگزینی SessionLocal در ماژول‌های مرتبط
import database
import database.config as db_config

database.SessionLocal = TEST_SESSION_FACTORY
database.engine = TEST_ENGINE

db_config.SessionLocal = TEST_SESSION_FACTORY
db_config.engine = TEST_ENGINE

# اصلاح globals توابع get_db
import types
for mod in [database, db_config]:
    for attr_name in dir(mod):
        attr = getattr(mod, attr_name, None)
        if isinstance(attr, types.FunctionType) and attr.__name__ == "get_db":
            attr.__globals__["SessionLocal"] = TEST_SESSION_FACTORY

