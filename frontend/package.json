{
  "name": "eco-nojin-monorepo",
  "version": "2.0.0",
  "private": true,
  "description": "Eco Nojin Monorepo — Digital Twin for Landscape Restoration (Frontend Rebuild)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:fix": "biome lint --write .",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.16.5",
    "orval": "^8.28.1",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ]
}