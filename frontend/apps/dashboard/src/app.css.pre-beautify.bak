@import "tailwindcss";
@import "../../../tooling/tailwind/tokens.css";

@source "../../../packages/ui/src";
@custom-variant dark (&:where(.dark, .dark *));

@layer base {
  :root {
    --font-sans: "Vazirmatn", system-ui, sans-serif;
  }
  
  body {
    font-family: var(--font-sans);
  }
}

@layer utilities {
  .typography-h1 { font-size: 1.875rem; line-height: 2.25rem; font-weight: 700; }
  .typography-h2 { font-size: 1.5rem; line-height: 2rem; font-weight: 600; }
  .typography-h3 { font-size: 1.25rem; line-height: 1.75rem; font-weight: 600; }
  .typography-body { font-size: 1rem; line-height: 1.5rem; }
  .typography-caption { font-size: 0.75rem; line-height: 1rem; color: var(--color-text-muted); }
}