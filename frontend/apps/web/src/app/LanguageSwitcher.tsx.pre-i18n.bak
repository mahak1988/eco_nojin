import { useTranslation } from 'react-i18next';
import type { Locale } from '@eco/config';
import { useSwitchLocale } from '@eco/i18n';
import { Dropdown, DropdownContent, DropdownItem, DropdownTrigger, Button } from '@eco/ui';

const LOCALES: { code: Locale; label: string }[] = [
  { code: 'fa', label: 'فارسی' },
  { code: 'ar', label: 'العربية' },
  { code: 'ur', label: 'اردو' },
  { code: 'en', label: 'English' },
];

export function LanguageSwitcher() {
  const { i18n } = useTranslation();
  const switchLocale = useSwitchLocale();
  const current = (i18n.language as Locale) ?? 'fa';

  return (
    <Dropdown>
      <DropdownTrigger asChild>
        <Button variant="ghost" size="sm" aria-label="Change language">
          🌐 {LOCALES.find((l) => l.code === current)?.label ?? current}
        </Button>
      </DropdownTrigger>
      <DropdownContent align="end">
        {LOCALES.map((l) => (
          <DropdownItem
            key={l.code}
            onSelect={() => switchLocale(l.code)}
            aria-current={l.code === current}
          >
            {l.label}
          </DropdownItem>
        ))}
      </DropdownContent>
    </Dropdown>
  );
}