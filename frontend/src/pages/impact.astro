---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { impact } from '../content/pages/impactcarbon';
---

<PublicLayout title="تأثیر | اکو نوژین" description="تأثیر قابل اندازه‌گیری: هکتار زیر پایش، کشاورز آموزش‌دیده، اعتبار کربن صادرشده، بهبود NDVI، صرفه‌جویی آب، CO₂ جلوگیری‌شده.">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="mx-auto max-w-4xl text-center mb-16">
      <p class="mb-2 text-sm font-extrabold text-[var(--color-leaf-400)]">تأثیر</p>
      <h1 class="text-3xl font-extrabold text-[var(--color-night-100)] sm:text-4xl">تأثیر قابل اندازه‌گیری</h1>
      <p class="mt-4 text-lg leading-7 text-[var(--color-night-200)]/60">ادعا نمی‌کنیم؛ اندازه می‌گیریم. متریک‌های تأثیر از روز نخست تعریف شده‌اند و پس از پایلوت، همین صفحه زنده می‌شود.</p>
    </header>

    <section class="mb-16" aria-labelledby="metrics-heading">
      <h2 id="metrics-heading" class="text-2xl font-extrabold text-[var(--color-night-100)] mb-6">متریک‌های تعریف‌شده</h2>
      <p class="text-[var(--color-night-200)]/60 mb-8">هر متریک با ترکیب پایش ماهواره‌ای و دادهٔ میدانی سنجیده می‌شود؛ انتشار با آغاز پایلوت آغاز می‌شود.</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {impact.fa.metrics.map((metric) => (
          <article class="glass glass-hover flex flex-col gap-3 rounded-2xl p-4">
            <h3 class="font-bold text-[var(--color-night-100)]">{metric.name}</h3>
            <div class="flex flex-wrap gap-2 text-[11px] text-[var(--color-night-200)]/50">
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-white/5">{metric.unit}</span>
              <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-white/5">{metric.frequency}</span>
            </div>
            <p class="text-xs text-[var(--color-night-200)]/40">منبع: {metric.source}</p>
            <p class="text-xs text-[var(--color-aqua-400)]/80">استاندارد: {metric.standard}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mb-16" aria-labelledby="live-counters-heading">
      <h2 id="live-counters-heading" class="text-2xl font-extrabold text-[var(--color-night-100)] mb-6">آمار لحظه‌ای</h2>
      <p class="text-[var(--color-night-200)]/60 mb-8">شمارش معکوس به پایلوت — داده‌های زنده پس از آغاز عملیات منتشر می‌شود</p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {impact.fa.liveCounters.items.map((counter) => (
          <article class="glass flex flex-col items-center gap-2 rounded-2xl p-6 text-center">
            <span class="text-3xl" aria-hidden>{counter.icon === 'satellite' ? '🛰️' : counter.icon === 'people' ? '👥' : counter.icon === 'co2' ? '🌿' : '🪙'}</span>
            <h3 class="text-sm font-bold text-[var(--color-night-200)]/60">{counter.label}</h3>
            <div class="text-3xl font-extrabold text-[var(--color-leaf-300)] tabular-nums" data-metric-key={counter.metricKey}>—</div>
            <span class="text-xs text-[var(--color-night-200)]/40">{counter.unit}</span>
          </article>
        ))}
      </div>
    </section>

    <astro-island component-url="../components/visuals/InteractiveSatelliteMap.tsx" client:visible props={{ projects: impact.fa.projects }} />
  </div>
</PublicLayout>