---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout title="۴۰۴ — صفحه پیدا نشد | اکو نوژین" description="صفحه مورد نظر یافت نشد. به صفحه اصلی برگردید یا از منوی ناوبری استفاده کنید.">
  <div class="flex min-h-[60vh] items-center justify-center px-4">
    <div class="text-center">
      <h1 class="text-6xl font-extrabold text-[var(--color-leaf-400)]">۴۰۴</h1>
      <h2 class="mt-4 text-2xl font-extrabold text-[var(--color-night-100)] sm:text-3xl">صفحه پیدا نشد</h2>
      <p class="mt-4 text-[var(--color-night-200)]/60 max-w-md mx-auto">مسیر درخواست‌شده وجود ندارد یا منتقل شده است. لطفاً آدرس را بررسی کنید یا از منوی ناوبری استفاده کنید.</p>
      <a href="/" class="mt-8 inline-flex items-center gap-2 rounded-full bg-[var(--color-leaf-500)] px-8 py-3.5 text-sm font-extrabold text-[var(--color-night-950)] transition-transform hover:scale-[1.02]">
        بازگشت به خانه
      </a>
    </div>
  </div>
</PublicLayout>