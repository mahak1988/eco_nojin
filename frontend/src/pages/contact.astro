---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout title="تماس | اکو نوژین" description="تماس با تیم اکو نوژین: ایمیل، فرم تماس، کانال‌های ارتباطی.">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="mx-auto max-w-4xl text-center mb-16">
      <p class="mb-2 text-sm font-extrabold text-[var(--color-leaf-400)]">تماس</p>
      <h1 class="text-3xl font-extrabold text-[var(--color-night-100)] sm:text-4xl">با ما در تماس باشید</h1>
      <p class="mt-4 text-lg leading-7 text-[var(--color-night-200)]/60">پرسش، پیشنهاد، نظر یا مشارکت؟ ما پاسخ می‌دهیم.</p>
    </header>

    <div class="grid gap-8 lg:grid-cols-2">
      <section class="space-y-6" aria-labelledby="form-heading">
        <h2 id="form-heading" class="text-2xl font-extrabold text-[var(--color-night-100)]">فرم تماس</h2>
        <form class="glass rounded-3xl p-6 space-y-4" action="/api/contact" method="POST">
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="name" class="block text-sm font-bold text-[var(--color-night-100)] mb-1">نام کامل</label>
              <input type="text" id="name" name="name" required class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[var(--color-night-100)] placeholder:text-[var(--color-night-200)]/30 focus:border-[var(--color-leaf-400)]/60 focus:outline-none" placeholder="مثال: علی احمدی" />
            </div>
            <div>
              <label for="email" class="block text-sm font-bold text-[var(--color-night-100)] mb-1">ایمیل</label>
              <input type="email" id="email" name="email" required class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[var(--color-night-100)] placeholder:text-[var(--color-night-200)]/30 focus:border-[var(--color-leaf-400)]/60 focus:outline-none" placeholder="ali@example.com" />
            </div>
          </div>
          <div>
            <label for="role" class="block text-sm font-bold text-[var(--color-night-100)] mb-1">نقش شما</label>
            <select id="role" name="role" required class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[var(--color-night-100)] focus:border-[var(--color-leaf-400)]/60 focus:outline-none">
              <option value="">انتخاب کنید...</option>
              <option value="farmer">کشاورز</option>
              <option value="researcher">پژوهشگر</option>
              <option value="investor">سرمایه‌گذار</option>
              <option value="developer">توسعه‌دهنده</option>
              <option value="partner">شرکا</option>
              <option value="other">سایر</option>
            </select>
          </div>
          <div>
            <label for="message" class="block text-sm font-bold text-[var(--color-night-100)] mb-1">پیام</label>
            <textarea id="message" name="message" rows="5" required class="w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-[var(--color-night-100)] placeholder:text-[var(--color-night-200)]/30 focus:border-[var(--color-leaf-400)]/60 focus:outline-none resize-none" placeholder="پیام شما..."></textarea>
          </div>
          <button type="submit" class="inline-flex items-center gap-2 rounded-full bg-[var(--color-leaf-500)] px-8 py-3.5 text-sm font-extrabold text-[var(--color-night-950)] transition-transform hover:scale-[1.02] active:scale-[0.98] w-full sm:w-auto">
            ارسال پیام
          </button>
        </form>
      </section>

      <section class="space-y-6" aria-labelledby="channels-heading">
        <h2 id="channels-heading" class="text-2xl font-extrabold text-[var(--color-night-100)]">کانال‌های ارتباطی</h2>
        <div class="glass rounded-3xl p-6 space-y-4">
          <a href="mailto:info@econojin.org" class="flex items-center gap-4 text-[var(--color-night-200)]/70 hover:text-[var(--color-leaf-300)] transition-colors p-4 rounded-2xl hover:bg-white/5">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-leaf-500)]/15 text-[var(--color-leaf-400)]" aria-hidden>✉️</span>
            <div>
              <p class="font-bold text-[var(--color-night-100)]">ایمیل مستقیم</p>
              <p class="text-sm">info@econojin.org</p>
            </div>
          </a>
          <a href="https://econojin.org" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 text-[var(--color-night-200)]/70 hover:text-[var(--color-leaf-300)] transition-colors p-4 rounded-2xl hover:bg-white/5">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-leaf-500)]/15 text-[var(--color-leaf-400)]" aria-hidden>🌐</span>
            <div>
              <p class="font-bold text-[var(--color-night-100)]">وب‌سایت</p>
              <p class="text-sm">econojin.org</p>
            </div>
          </a>
          <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/3">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-aqua-500)]/15 text-[var(--color-aqua-400)]" aria-hidden>🤖</span>
            <div>
              <p class="font-bold text-[var(--color-night-100)]">ربات‌های پیام‌رسان</p>
              <p class="text-sm">تلگرام، ایتا، بله، روبیکا</p>
            </div>
          </div>
          <div class="flex items-center gap-4 p-4 rounded-2xl bg-white/3">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--color-sand-500)]/15 text-[var(--color-sand-400)]" aria-hidden>📞</span>
            <div>
              <p class="font-bold text-[var(--color-night-100)]">USSD / SMS</p>
              <p class="text-sm">*۱۲۳*۱۲۳# (نمونه)</p>
            </div>
          </div>
        </div>
      </section>
    </div>
  </div>
</PublicLayout>