---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout title="پرسش‌های متداول | اکو نوژین" description="پاسخ به پرسش‌های پرتکرار درباره اکو نوژین، هیدروما، اکوکوین، کانال‌های دسترسی، و اقتصاد کربن.">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="mx-auto max-w-4xl text-center mb-16">
      <p class="mb-2 text-sm font-extrabold text-[var(--color-leaf-400)]">پرسش‌های متداول</p>
      <h1 class="text-3xl font-extrabold text-[var(--color-night-100)] sm:text-4xl">پاسخ پرسش‌های پرتکرار</h1>
      <p class="mt-4 text-lg leading-7 text-[var(--color-night-200)]/60">پاسخ‌های رایج به سوالات کاربران، کشاورزان، توسعه‌دهندگان و سرمایه‌گذاران.</p>
    </header>

    <section aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="sr-only">دسته‌بندی پرسش‌ها</h2>
      <dl class="space-y-4 max-w-3xl mx-auto">
        {[
          { q: 'اکو نوژین چیست؟', a: 'اکو نوژین یک پلتفرم علمی بین‌المللی برای احیای اکوسیستم، کشاورزی هوشمند، مدیریت آب و خاک، اقتصاد کربن و رونق روستایی است. موتور علمی آن «هیدروما» نام دارد که شامل ۳۸ زیرماژول علمی، ۶۱ مدل فیزیکی قطعی و پایش ماهواره‌ای سنتینل-۲ می‌باشد.' },
          { q: 'هیدروما چه مدل‌هایی را شامل می‌شود؟', a: 'هیدروما شامل مدل‌های ریچاردز (جریان آب در خاک)، سنت‌ونان (هیدرولیک سطحی)، FAO-56 (تبخیر-تعرق)، روت‌سی (چرخه کربن خاک)، SWAT (حوزه آبخیز)، روسل (فرسایش)، NSGA-II (بهینه‌سازی چندهدفه) و دیگر مدل‌های فیزیکی قطعی است.' },
          { q: 'کانال‌های دسترسی اکو نوژین کدام‌اند؟', a: 'پنج کانال: ۱) وب و PWA ۲) USSD (بدون اینترنت) ۳) SMS ۴) ربات پیام‌رسان (تلگرام، ایتا، بله، روبیکا) ۵) دستیار صوتی (برای کم‌سوادان).' },
          { q: 'اکوکوین (Eco Coin) چیست؟', a: 'اکوکوین واحد دیجیتال اعتبار اکو نوژین است. در فاز یک توکن کاربردی برای دسترسی به خدمات پلتفرم است. در فاز دو (پس از تأیید قانونی) اعتبار کربنی معادل یک تن CO₂e خواهد بود که تنها پس از راستی‌آزمایی مستقل ISO 14064-2 صادر می‌شود.' },
          { q: 'چگونه در پایلوت ایران شرکت کنم؟', a: 'کشاورزان می‌توانند از طریق صفحه «پایلوت ایران» زمین خود را ثبت کنند. برای مشارکت به‌عنوان محقق، توسعه‌دهنده یا سرمایه‌گذار، از صفحه «فرصت‌ها» و «تماس» استفاده کنید.' },
          { q: 'داده‌های ماهواره‌ای چگونه جمع‌آوری می‌شوند؟', a: 'داده‌ها از سنتینل-۲ (کوپرنیکوس CDSE) با اعتبارنامه رسمی، ERA5 (بازتحلیل اقلیمی) و SoilGrids (خواص خاک) استخراج و پردازش می‌شوند.' },
          { q: 'آیا اکو نوژین متن‌باز (Open Source) است؟', a: 'بله، هستهٔ پلتفرم تحت مجوز MIT منتشر می‌شود. کد منبع در GitHub در دسترس است.' },
          { q: 'چگونه اعتبار کربن تأیید می‌شود؟', a: 'از طریق چرخه MRV بر اساس ISO 14064-2: اندازه‌گیری ماهواره‌ای و میدانی، محاسبه مدل‌محور، گزارش شفاف، راستی‌آزمایی مستقل (VVB)، سپس ثبت روی بلاکچین پالیگون.' },
        ].map((faq) => (
          <div class="glass rounded-2xl overflow-hidden">
            <dt class="p-4 sm:p-6 cursor-pointer font-bold text-[var(--color-night-100)] select-none">{faq.q}</dt>
            <dd class="p-4 sm:p-6 text-[var(--color-night-200)]/70 border-t border-white/5">{faq.a}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</PublicLayout>