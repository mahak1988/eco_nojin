---
import PublicLayout from '../../layouts/PublicLayout.astro';
---

<PublicLayout title="اقتصاد کربن | اکو نوژین" description="رجیستری کربن اکو نوژین: ثبت زمین، پایش ماهواره‌ای و میدانی، تأیید MRV، ثبت بلاکچین روی پالیگون.">
  <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="mx-auto max-w-4xl text-center mb-16">
      <p class="mb-2 text-sm font-extrabold text-[var(--color-leaf-400)]">پروژه‌های کربن</p>
      <h1 class="text-3xl font-extrabold text-[var(--color-night-100)] sm:text-4xl">رجیستری کربن، از مزرعه تا بلاکچین</h1>
      <p class="mt-4 text-lg leading-7 text-[var(--color-night-200)]/60">مسیر اعتبار کربن اکو نوژین، شفاف و مرحله‌به‌مرحله است؛ نقشهٔ پروژه‌های فعال با نخستین پایلوت زنده می‌شود.</p>
    </header>

    <section class="mb-16" aria-labelledby="how-heading">
      <h2 id="how-heading" class="text-2xl font-extrabold text-[var(--color-night-100)] mb-6">مسیر اعتبار کربن</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          { step: '۰۱', icon: '📝', title: 'ثبت زمین', desc: 'کشاورز زمین و اقدام حفاظتی را ثبت می‌کند.' },
          { step: '۰۲', icon: '🛰️', title: 'اندازه‌گیری', desc: 'پایش ماهواره‌ای + ثبت میدانی KoBo.' },
          { step: '۰۳', icon: '✅', title: 'تأیید', desc: 'محاسبهٔ مدل‌محور و راستی‌آزمایی گزارش MRV.' },
          { step: '۰۴', icon: '⛓️', title: 'ثبت و فروش', desc: 'اعتبار با تأیید بلاکچین روی پالیگون ثبت می‌شود.' },
        ].map((item) => (
          <article class="glass glass-hover flex flex-col gap-4 rounded-3xl p-6 relative">
            <div class="absolute -top-3 start-3 text-3xl font-extrabold text-[var(--color-leaf-500)]/20">{item.step}</div>
            <span class="text-3xl" aria-hidden>{item.icon}</span>
            <h3 class="text-lg font-extrabold text-[var(--color-night-100)]">{item.title}</h3>
            <p class="text-sm leading-6 text-[var(--color-night-200)]/60">{item.desc}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="glass rounded-3xl p-6 sm:p-8" aria-labelledby="status-heading">
      <h2 id="status-heading" class="text-2xl font-extrabold text-[var(--color-night-100)] mb-4">وضعیت فعلی</h2>
      <p class="text-[var(--color-night-200)]/60">زیرساخت رجیستری و زنجیرهٔ MRV آماده است؛ نخستین پروژه‌ها و نقشهٔ زندهٔ آن‌ها با آغاز پایلوت در همین صفحه منتشر می‌شود.</p>
    </section>
  </div>
</PublicLayout>