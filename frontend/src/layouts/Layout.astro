---
interface Props {
  title: string;
  description?: string;
  lang?: 'fa' | 'en';
}

const { title, description, lang = 'fa' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang} dir={lang === 'fa' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <!-- Font preload: Vazirmatn (self-hosted, font-display: swap in CSS) -->
    <link rel="preload" href="/fonts/vazirmatn-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/vazirmatn-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Eco Nojin" />
    <meta property="og:image" content="https://econojin.org/og.png" />
    <meta property="og:url" content={`https://econojin.org${Astro.url.pathname}`} />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content="https://econojin.org/og.png" />
    
    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#04100b" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="اکو نوژین" />
    <link rel="apple-touch-icon" href="/icons/icon-192x192.png" />
    
    <!-- Fonts -->
    <!-- Fonts are self-hosted via @fontsource (src/index.css), preloaded above -->
    
    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/icon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/icon-16x16.png" />
    
    <!-- Canonical -->
    <link rel="canonical" href={`https://econojin.org${Astro.url.pathname}`} />
    
    <!-- Language alternates -->
    {lang === 'fa' && (
      <>
        <link rel="alternate" hreflang="en" href={`https://econojin.org${Astro.url.pathname.replace(/^\//, '/en/')}`} />
        <link rel="alternate" hreflang="fa" href={`https://econojin.org${Astro.url.pathname}`} />
        <link rel="alternate" hreflang="x-default" href={`https://econojin.org${Astro.url.pathname}`} />
      </>
    )}
    {lang === 'en' && (
      <>
        <link rel="alternate" hreflang="en" href={`https://econojin.org${Astro.url.pathname}`} />
        <link rel="alternate" hreflang="fa" href={`https://econojin.org${Astro.url.pathname.replace(/^\/en/, '')}`} />
        <link rel="alternate" hreflang="x-default" href={`https://econojin.org${Astro.url.pathname.replace(/^\/en/, '')}`} />
      </>
    )}
  </head>
  <body class="min-h-screen bg-[var(--color-night-950)] text-[var(--color-night-100)]">
    <slot />
    
    <!-- PWA Registration Script -->
    <script type="module">
      import '../scripts/pwa.ts';
    </script>
  </body>
</html>