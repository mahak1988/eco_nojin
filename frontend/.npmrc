# pnpm v11 configuration for Eco Nojin monorepo

auto-install-peers=true
strict-peer-dependencies=false
prefer-frozen-lockfile=false
shamefully-hoist=false

# pnpm 11: allow specific packages to run build scripts.
# Required to suppress ERR_PNPM_IGNORED_BUILDS cascading into Turbo failures.
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*types*strict-dep-builds=false
