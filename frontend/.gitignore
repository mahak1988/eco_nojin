# =============================================================================
# frontend/.gitignore — comprehensive
# =============================================================================

# --- Node / pnpm / turbo ---
node_modules/
dist/
build/
.vite/
pnpm-debug.log*
.turbo/
**/*.tsbuildinfo

# --- Environment & secrets ---
.env
.env.local
.env.*.local
!.env.example
!.env.template

# --- OS ---
.DS_Store
Thumbs.db

# --- IDE ---
.idea/
*.swp
*.swo
*~
.vscode/
!.vscode/settings.json
!.vscode/extensions.json

# --- Test / coverage ---
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-artifacts/

# --- Build / cache ---
.cache/
.parcel-cache/
*.log
*.tmp

# --- Data ---
**/*.sqlite
**/*.db
**/*.db-wal
**/*.wal

# --- Local-only ---
/backups/
/DELIVERY/
/_quarantine/
/logs/
