# Eco Nojin frontend environment configuration
# Copy this file to `frontend/.env` and adjust values as needed.

# Base URL of the Eco Nojin backend API (FastAPI gateway).
# In development the Vite dev server proxies /api -> http://localhost:8000,
# so this only matters when the backend is hosted elsewhere.
VITE_API_BASE_URL=http://localhost:8000
