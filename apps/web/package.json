{
  "name": "@eco/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "type-check": "tsc --noEmit",
    "generate:api": "orval --config ../../orval.config.ts",
    "lint": "biome check src/",
