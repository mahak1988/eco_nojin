    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.5.4",
