{
  "name": "@eco/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "type-check": "tsc --noEmit",
    "generate:api": "orval --config ../../orval.config.ts",
    "lint": "biome check src/",
    "format": "biome format --write src/",
    "format:check": "biome format src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test tests/cover.spec.ts tests/home.spec.ts tests/market.spec.ts tests/security.spec.ts tests/auth-ui.spec.ts tests/i18n.spec.ts --project=chromium",
    "test:e2e:full": "playwright test",
    "test:cwv": "node ../../scripts/check-cwv.mjs",
    "i18n:compile": "node scripts/i18n-check.mjs && node ../../scripts/check-message-usage.mjs && node ../../scripts/check-locale-depth.mjs && node ../../scripts/check-locale-encoding.mjs && node ../../scripts/check-page-meta.mjs && node ../../scripts/check-font-coverage.mjs",
    "check:site-url": "node ../../scripts/check-site-url.mjs && node ../../scripts/check-ui-kit.mjs && node ../../scripts/check-orphan-components.mjs",
    "check:tokens": "node ../../scripts/check-token-references.mjs && node ../../scripts/check-colour-utilities.mjs . && node ../../scripts/check-contrast.mjs",
    "quality": "pnpm lint && pnpm format:check && pnpm type-check && pnpm test && pnpm i18n:compile && pnpm check:site-url && pnpm check:tokens"
  },
  "dependencies": {
    "@eco/api-client": "workspace:*",
    "@eco/ui": "workspace:*",
    "@hookform/resolvers": "^5.9.1",
    "@serwist/next": "^9.5.12",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.10.0",
    "next": "^15.5.4",
    "next-intl": "^4.3.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.88.0",
    "redis": "^6.2.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.3.1",
    "web-vitals": "^6.2.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.14",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "^30.1.1",
    "lighthouse": "^13.5.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
