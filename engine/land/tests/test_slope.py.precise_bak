"""Tests for Slope and Aspect Calculator"""

import pytest
import numpy as np
from engine.land.slope_aspect import SlopeAspectAnalyzer


class TestSlopeAspectAnalyzer:
    """تست‌های محاسبه‌گر شیب و جهت"""
    
    @pytest.fixture
    def calculator():
        """Create a SlopeAspectAnalyzer with proper DEMProcessor"""
        from engine.land.dem_processor import DEMProcessor
        from engine.land.slope_aspect import SlopeAspectAnalyzer
        
        # Create a mock DEMProcessor
        class MockDEMProcessor:
            def __init__(self):
                self._data = np.array([[100, 100], [100, 100]])
                self.resolution = 30.0
        
        dem_proc = MockDEMProcessor()
        return SlopeAspectAnalyzer(dem_proc)