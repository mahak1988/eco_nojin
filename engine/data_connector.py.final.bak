"""
engine.data_connector
=====================
اتصال موتور پردازش به هاب مرکزی داده

این ماژول موتور پردازش را به هاب مرکزی داده متصل می‌کند.
"""

from pathlib import Path
from typing import Optional, Any

# افزودن مسیر ریشه به پایتون‌پث
PROJECT_ROOT = Path(__file__).resolve().parents[1]
import sys
if str(PROJECT_ROOT) not in sys.path:
    sys.path.insert(0, str(PROJECT_ROOT))

from database.hub import DataHub


class ProcessingEngineConnector:
    """
    اتصال‌دهنده موتور پردازش به هاب داده
    """
    
    def __init__(self):
        self.hub = DataHub()
    
    def get_master_data(self) -> Any:
        """دریافت داده‌های اصلی"""
        return self.hub.get_duckdb("master")
    
    def get_analytics_data(self) -> Any:
        """دریافت داده‌های تحلیلی"""
        return self.hub.get_duckdb("analytics")
    
    def get_manual_data(self) -> Any:
        """دریافت داده‌های دستی"""
        return self.hub.get_sqlite("manual")
    
    def get_database_session(self) -> Any:
        """دریافت نشست دیتابیس"""
        return self.hub.get_sqlalchemy_engine()


# نمونه استفاده
connector = ProcessingEngineConnector()
