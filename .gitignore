# ============================================================
# EcoNojin / HyDroMa — .gitignore
# Phase 0 infrastructure: never commit secrets, caches, or env
# ============================================================

# --- Environment & secrets ---
.env
.env.*
!.env.example

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.db
*.sqlite3
*.duckdb

# --- Virtual environments ---
.venv/
venv/
env/

# --- Type checking & linting caches ---
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- Node / Next.js frontend ---
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env*
npm-debug.log*
pnpm-debug.log*
*.tsbuildinfo

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- OS ---
.DS_Store
Thumbs.db

# --- Project data (never commit raw data) ---
data/raw/
data/processed/
data/external/
data/*.db

# --- Logs & temp ---
logs/
*.log
tmp/
