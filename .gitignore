# Virtual environment (2.2 GB — never commit)
.venv/

# Local secrets — never commit. .env.example is the committed template.
.env
.env.*
!.env.example
*.key
*.pem
privacy_vault/

# Caches and generated artifacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.benchmarks/
.snapshots/
.mypy_out.txt

# Generated reports/artifacts
temp_imports*.json
openapi.json

# Runtime data (regenerated by tools/tests — never commit; see
# reports/release/COMMIT-PLAN-2026-10-10.md)
data/cache/
data/copernicus_cache/
data/motors/
data/maps/
data/master/
data/rag/
data/reports/
*.duckdb
# NOTE (verified 2026-10-11): data/security/audit.jsonl is no longer tracked
# (`git rm --cached` was executed by an earlier session) — the rule below keeps
# the ~36 MB runtime security log out of the index. Delete a stale local copy
# with tools/cleanup.py --include-data-security if you do not need its history.
data/security/

# OS / editor
.vscode/
.DS_Store

# ---------------------------------------------------------------------------
# Added by the root-cleanup pass (2026-10-11). The sections above already cover
# the venv, secrets, the main caches and the data/ runtime trees; these close
# the remaining gaps found in the live tree.
# ---------------------------------------------------------------------------

# Application cache / output directories (recreated on demand)
cache/
.satellite_cache/
outputs/

# C++ / native build intermediates (cmake + ninja regenerate them; the shipped
# extension lives in engine/hydroma/cpp_bridge/*.pyd)
build/
build2/
*.obj
*.iobj
*.ipdb
*.pdb

# Numba on-disk kernel cache
*.nbi
*.nbc

# Backups and logs. ``run.log`` was untracked by the artifact-staging change
# (git rm --cached), so these rules cover it now — an ignore rule never
# untracks a file on its own.
*.log
*.bak

# Tool scratch outputs (detect_imports / scans)
tools/*_output*.json
tools/eco04_comprehensive_scan.json

# Coverage artifacts
.coverage
coverage.xml
htmlcov/

# Generic temp files
*.tmp
temp_*

# --- C++ build artefacts (added 2026-10-11 by the root-cleanup pass) ---
# A CMake/MSVC build tree was committed under engine/cpp_core/ (140+ tracked
# files: .obj, .tlog, .exp, CMakeCache.txt, .vcxproj). They are build outputs,
# not source, and several were already deleted from the working tree.
# git rm --cached -r engine/cpp_core/build engine/cpp_core/build2 removes
# them from the index; these rules keep them out.
engine/cpp_core/build/
engine/cpp_core/build2/
engine/cpp_core/**/CMakeFiles/
engine/cpp_core/**/CMakeCache.txt
engine/cpp_core/Testing/
*.obj
*.tlog
*.exp
*.pdb
*.ilk
*.recipe
*.vcxproj*
CMakeUserPresets.json

# P12 frontend (build artifacts and dependencies) — REMOVED: the SPA tree was
# deleted from this repository; the rules below are kept only as belt-and-
# braces so a stray npm/pnpm install can never be re-committed here.
node_modules/
dist/
pnpm-debug.log
*.tsbuildinfo

# Local scratch / tool output (20k+ files; keeps git status and decorations sane)
tmp/
