# ==============================================================================
# eco_nojin .gitignore (Optimized by Senior Architect)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (بالاترین اولویت امنیتی)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example
!.env.template
secrets/
*.key
*.pem
*.p12
*.pfx

# ------------------------------------------------------------------------------
# 2. System & OS Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# ------------------------------------------------------------------------------
# 3. IDE & Editors
# ------------------------------------------------------------------------------
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 4. Python
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
env/

# Jupyter Notebook (مهم برای پوشه ml/notebooks)
.ipynb_checkpoints/

# ------------------------------------------------------------------------------
# 5. Node.js / pnpm / Frontend Build
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

frontend/dist/
frontend/build/
frontend/.vite/

# ------------------------------------------------------------------------------
# 6. C++ Engine Build Outputs (موتور Hydroma)
# ------------------------------------------------------------------------------
engine/cpp_core/build2/
*.obj
*.o
*.a
*.lib
*.exe
*.dll
*.so
*.dylib
*.iobj
*.ipdb
*.pdb
*.tlog
*.lastbuildstate
*.vcxproj
*.recipe

# ------------------------------------------------------------------------------
# 7. Database & Heavy Binary Data (جلوگیری از فاجعه حجم ریپازیتوری)
# ------------------------------------------------------------------------------
# دیتابیس‌ها
*.db
*.sqlite
*.sqlite3
*.duckdb  # ❗ بسیار مهم: فایل ۲۷ مگابایتی پروژه

# فایل‌های جغرافیایی و رستری حجیم
*.tif
*.tiff
*.nc
*.h5
*.hdf
*.gpkg  # ❗ بسیار مهم: فایل‌های ۱۰ مگابایتی نقشه‌های توپوگرافی
*.shp
*.shx
*.dbf
*.prj

# فایل‌های فشرده و دیتای خام
*.zip     # ❗ بسیار مهم: ۱۶۲ مگابایت فایل zip در پروژه
*.tar.gz
*.rar
*.7z
*.pkl

# ------------------------------------------------------------------------------
# 8. ML Models & Datasets (وزن‌های آموزش دیده)
# ------------------------------------------------------------------------------
*.pt
*.pth
*.onnx
*.bin
*.safetensors
ml/models/
data/raw/
data/processed/

# ------------------------------------------------------------------------------
# 9. Project Specific Directories (پوشه‌های زباله‌دان و موقت پروژه)
# ------------------------------------------------------------------------------
# بکاپ‌های دستی (نباید در گیت باشند)
_backups/
backups/
DELIVERY/

# قرنطینه و اسکنرهای قدیمی
_quarantine/
analysis.json/

# کش‌های پردازشی
data/copernicus_cache/
data/maps/cache/
.satellite_cache/
.cache/
.parcel-cache/
.turbo/

# ------------------------------------------------------------------------------
# 10. Logs & Reports
# ------------------------------------------------------------------------------
*.log
logs/
reports/
*.log.*
benchmarks/

# ------------------------------------------------------------------------------
# 11. Testing & Coverage Artifacts
# ------------------------------------------------------------------------------
coverage/
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-artifacts/
frontend/test-results/
frontend/playwright-report/
html/

# ------------------------------------------------------------------------------
# 12. Blockchain (Hardhat & Secrets)
# ------------------------------------------------------------------------------
contracts/artifacts/
contracts/cache/
contracts/typechain-types/
contracts/.env

# ------------------------------------------------------------------------------
# 13. Documentation Build
# ------------------------------------------------------------------------------
docs/_build/
docs/.doctrees/