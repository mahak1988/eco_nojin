# =============================================================================
# ECO NOJIN - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# =============================================================================

# Application
APP_NAME=Eco Nojin
APP_ENV=development
DEBUG=true
APP_URL=http://127.0.0.1:8000

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/eco_nojin

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Authentication
JWT_SECRET_KEY=change-this-in-production
JWT_ALGORITHM=HS256

# External APIs
COPERNICUS_CDS_API_KEY=your-cds-key
COPERNICUS_ADS_API_KEY=your-ads-key

# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token

# Default Values
DEFAULT_LATITUDE=35.6892
DEFAULT_LONGITUDE=51.3890
DEFAULT_TEMP=22.5
DEFAULT_PRECIP=5.0
DEFAULT_HUMIDITY=65.0
DEFAULT_PH=6.5
ADMIN_TEMP=0.4

# Redis
REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO

# Supabase (Phase 6+)
SUPABASE_PROJECT_REF=cpncggavcfplewlhvvnw
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_ACCESS_TOKEN=sbp_your_management_api_pat
# JWT passthrough: apikey=anon + Authorization=Bearer <user JWT>

# Phase 8-C: AI advice (BYO free LLM key, e.g. Groq free tier)
# Get a free key at https://console.groq.com -> API Keys
AI_LLM_KEY=
AI_LLM_URL=https://api.groq.com/openai/v1/chat/completions
AI_LLM_MODEL=llama-3.3-70b-versatile

# Phase 8-C: anti-phishing trusted domains (comma separated)
TRUSTED_DOMAINS=econojin.ir,econojin.com