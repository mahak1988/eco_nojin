# Copy to .env and fill in real values. Never commit .env.
# Phase 0: all runtime config now flows through pydantic-settings.

# --- Environment ---
ENVIRONMENT=development          # development | testing | production
DEBUG=false
LOG_LEVEL=INFO

# --- Security: GENERATE a strong key in production ---
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200
# Shared secret for USSD/SMS/Voice telco webhooks (empty = disabled in dev)
TELCO_WEBHOOK_KEY=

# --- CORS: explicit origins, never * with credentials in production ---
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ALLOW_CREDENTIALS=true

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
# SQLite (default):  sqlite:///./data/econojin.db
# PostGIS (docker):  postgresql+psycopg://eco_nojin:YOUR_PASSWORD@localhost:5432/eco_nojin
DATABASE_URL=sqlite:///./data/econojin.db
REDIS_URL=redis://localhost:6379/0

# --- External integrations ---
# Sentinel-2 / Planetary Computer (empty = simulated data until W-001 staged)
SATELLITE_API_KEY=
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=eco_nojin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eco_nojin

# Telegram bot (Phase 1) — get token from @BotFather
BOT_TOKEN=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Phase 2: multi-platform (Eitaa = Telegram-compatible API)
EITAA_TOKEN=
EITAA_ENABLED=false
BALE_TOKEN=
BALE_ENABLED=false
RUBIKA_TOKEN=
RUBIKA_ENABLED=false

# --- Phase 4: Copernicus Data Space Ecosystem ---
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_BASE_URL=https://catalogue.dataspace.copernicus.eu
CDSE_IDENTITY_URL=https://identity.dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=

# Copernicus Climate Data Store (ERA5 reanalysis)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_UID=
CDS_API_KEY=

# Copernicus data stores (free; key link: <store>/how-to-api)
EWDS_API_URL=https://ewds.climate.copernicus.eu/api
EWDS_UID=
EWDS_API_KEY=
ADS_API_URL=https://ads.atmosphere.copernicus.eu/api
ADS_UID=
ADS_API_KEY=
# SEPAL (FAO) — no key: https://sepal.io (Google/GitHub login)
SEPAL_BASE_URL=https://sepal.io


# =============================================================================
# NEW INTEGRATION VARIABLES (Added for platform integration)
# =============================================================================

# --- Supabase ---
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- AI Services ---
GROQ_API_KEY=your_groq_api_key
QDRANT_URL=your_qdrant_url
QDRANT_API_KEY=your_qdrant_api_key

# --- Blockchain (Polygon) ---
ALCHEMY_API_KEY=your_alchemy_key
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_WALLET_ADDRESS=your_wallet_address

# --- Cloudflare R2 ---
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_R2_BUCKET_NAME=econojin-assets
