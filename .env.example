# =============================================================================
# HyDroMA / Eco Nojin - environment template
# =============================================================================
# Copy to .env and fill in the values you need:
#     cp .env.example .env
#
# .env is git-ignored and must NEVER be committed. This file is the template
# and contains no secrets. Every registration link below is marked with 🔑 and
# opens the page where the key is issued.
# Full machine-readable catalog of every connected endpoint (with live
# verification status): data/links/external_links.json
#
# Every variable is OPTIONAL unless marked [REQUIRED for production]. The
# application boots with an empty .env: each external dependency fails with a
# typed, named error rather than fabricated data.
#
# Free, key-less data sources (no entry needed here):
#   NASA POWER      https://power.larc.nasa.gov/
#   Open-Meteo      https://open-meteo.com/
#   CHIRPS          https://www.chc.ucsb.edu/data/chirps
#   SoilGrids       https://soilgrids.org/
#   WorldClim       https://www.worldclim.org/
#   GBIF            https://www.gbif.org/developer/summary
#   CDS STAC search https://stac.dataspace.copernicus.eu/v1   (download needs OAuth below)
#   Earth Search    https://earth-search.aws.element84.com/v1
#   Planetary Computer https://planetarycomputer.microsoft.com/
#   FAO WaPOR v3    https://wapor.apps.fao.org/home/WAPOR_2/1  (no API key since 2025-08)
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | staging | production | test
DEBUG=false
APP_NAME=HyDroMA
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
DEFAULT_LANGUAGE=fa

# Prometheus scrape key for /metrics. The endpoint is fail-closed: unset or
# blank => 401 for every caller (no anonymous metrics). Pod-annotation
# scraping (prometheus.io/scrape) cannot send a header, so a keyed deployment
# needs a ServiceMonitor/scrape-config with an Authorization header — see
# engine/hydroma/production/deployment.py.
HYDROMA_METRICS_API_KEY=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
# [REQUIRED for production, strongly recommended locally]
# Generate with:  python -c "import secrets;print(secrets.token_urlsafe(48))"
# JWT_SECRET is preferred over SECRET_KEY; both must be >= 32 chars and are
# checked against a list of known-weak development values.
SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200
ALLOWED_ROLES=farmer,advisor,admin,researcher,organization,tourist
DEFAULT_USER_ROLE=farmer
ENABLE_LOCAL_OAUTH_FALLBACK=false   # dev-only affordance; must stay false in production

# WebAuthn / passkeys (origin must match the deployment URL)
PASSKEY_RP_ID=
PASSKEY_ORIGIN=

# -----------------------------------------------------------------------------
# CORS  (JSON array - pydantic parses lists as JSON, not comma-separated)
# -----------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# DATABASE / REFERENCE DATA
# -----------------------------------------------------------------------------
# Left empty the default is SQLite in memory for the ORM and
# data/master/eco_nojin_master.duckdb for the reference store built by
# tools/build_master_duckdb.py (5 real tables with SHA-256 provenance).
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/hydroma
ECO_MASTER_DUCKDB=data/master/eco_nojin_master.duckdb

# -----------------------------------------------------------------------------
# SATELLITE / CLIMATE  (optional - connectors fail with a named error if absent)
# -----------------------------------------------------------------------------
# Copernicus Data Space Ecosystem - Sentinel-1/2 download (free registration).
# 🔑 https://dataspace.copernicus.eu/  (Sign up -> User Settings -> OAuth clients)
#    📖 https://documentation.dataspace.copernicus.eu/
# STAC search works without these; only product download needs them.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_USERNAME=
CDSE_PASSWORD=
CDSE_IDENTITY_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_BASE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1

# Copernicus Climate Data Store - ERA5 reanalysis.
# 🔑 https://cds.climate.copernicus.eu/how-to-api  (login -> Profile -> API key)
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
COPERNICUS_CDS_API_KEY=
COPERNICUS_CDS_URL=https://cds.climate.copernicus.eu/api/v2
COPERNICUS_ADS_API_KEY=            # Atmosphere Data Store - same CDS account
COPERNICUS_ADS_URL=https://ads.atmosphere.copernicus.eu/api/v2
COPERNICUS_EWDS_API_KEY=           # European Water Deployment
COPERNICUS_EWDS_URL=https://ewds.climate.copernicus.eu/api/v2

# Sentinel Hub dashboard (free tier).
# 🔑 https://apps.sentinel-hub.com/dashboard/
SATELLITE_API_KEY=
PLANETARY_COMPUTER_API_KEY=
# 🔑 Planetary Computer SAS token: https://planetarycomputer.microsoft.com/account/request
OPENWEATHERMAP_API_KEY=
# 🔑 https://home.openweathermap.org/api_keys
ENABLE_SATELLITE_REAL=true

# -----------------------------------------------------------------------------
# AI / DANESHYAR (RAG)  --  offline defaults, no paid service
# -----------------------------------------------------------------------------
# ai_provider: ollama (local, no key) | openai | anthropic | groq
# 🔑 Ollama (FREE, local, NO key at all): https://ollama.com/download
#    then: ollama pull qwen3:4b
AI_PROVIDER=ollama
AI_LLM_URL=http://127.0.0.1:11434/v1
AI_LLM_MODEL=
AI_LLM_TIMEOUT=60
AI_LLM_KEY=                        # only for hosted providers
ENABLE_AI_ASSISTANT=true

# --- local-first agents (services/ai/support_agent.py, admin_assistant.py) ---
# These two agents talk to a LOCAL Ollama server and need no key at all.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# --- cloud router chain (services/ai/llm_router.py) ---------------------------
# OpenAI-compatible endpoints; a provider activates automatically when its key
# is present, in this priority: GROQ -> OPENROUTER -> GOOGLE -> MISTRAL -> DEEPSEEK
# All have a FREE tier (dashboards block bots - open them in a browser):
#   🔑 Groq (free, fastest)           https://console.groq.com/keys
#   🔑 OpenRouter (free :free models) https://openrouter.ai/keys
#   🔑 Google Gemini (free tier)      https://aistudio.google.com/apikey
#   🔑 Mistral (free experimentation) https://console.mistral.ai/api-keys
#   🔑 DeepSeek (paid, signup credit) https://platform.deepseek.com/api_keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# hosted providers (paid unless noted):
# 🔑 Groq (free tier):  https://console.groq.com/keys
GROQ_API_KEY_ALIAS=
# 🔑 Anthropic:        https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# 🔑 OpenAI:           https://platform.openai.com/api-keys
OPENAI_API_KEY=
WHISPER_API_KEY=                   # OpenAI Whisper API - same account as OPENAI_API_KEY

# --- embeddings (services/ai/embedding_service.py) ----------------------------
# Free tiers (dashboards block bots - open in a browser):
#   🔑 Jina (10M tokens/month free)  https://jina.ai/embeddings
#   🔑 Cloudflare Workers AI (free daily neurons, needs CLOUDFLARE_ACCOUNT_ID)
#                                    https://dash.cloudflare.com/
#   🔑 Cohere (free tier)            https://dashboard.cohere.com/api-keys
JINA_API_KEY=
CLOUDFLARE_API_TOKEN=
COHERE_API_KEY=
# Local fallback already installed in this environment: sentence-transformers
# 6.0.0 + torch 2.13 (CPU) -> offline embeddings, no key.

# Qdrant: empty URL = the RAG index runs in-process (local, no key)
# 🔑 Qdrant Cloud (optional, free 1GB tier): https://cloud.qdrant.io/
QDRANT_URL=
QDRANT_API_KEY=
HYDROMA_RAG_ENGINE=local
HYDROMA_RAG_CATALOG=

# -----------------------------------------------------------------------------
# MESSAGING BOTS  (optional)
# -----------------------------------------------------------------------------
BOT_TOKEN=                         # generic bot token used by services/bots
# 🔑 Telegram BotFather (free):    https://t.me/BotFather   -> /newbot
TELEGRAM_BOT_TOKEN=
BALE_TOKEN=
EITAA_TOKEN=
RUBIKA_TOKEN=
# 🔑 WhatsApp Cloud API (free sandbox): https://developers.facebook.com/apps/
WHATSAPP_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# 🔑 Twilio console (free trial credit): https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TTS_PROVIDER=
VOICE_API_BASE_URL=

# -----------------------------------------------------------------------------
# MRV / FIELD DATA  (optional)
# -----------------------------------------------------------------------------
# 🔑 KoboToolbox (free): https://kf.kobotoolbox.org/ -> Account Settings -> API
KOBO_TOKEN=
MRV_INGEST_KEY=
TELCO_WEBHOOK_KEY=

# -----------------------------------------------------------------------------
# SCIENCE PUBLISHING / CARBON REGISTRIES  (optional)
# -----------------------------------------------------------------------------
# 🔑 Zenodo personal access token (free DOI): https://zenodo.org/account/settings/applications/tokens/new/
ZENODO_TOKEN=
ZENODO_SANDBOX=false
# 🔑 Verra registry account: https://verra.org/  (Register; approval required)
VERRA_API_KEY=
VERRA_API_SECRET=

# -----------------------------------------------------------------------------
# SUPABASE  (optional - OGC API, audit and auth sync fall back when absent)
# -----------------------------------------------------------------------------
# 🔑 Supabase dashboard (free 500MB tier): https://supabase.com/dashboard
#    Project -> Settings -> API. service_role key is ADMIN scope - never expose.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
SUPABASE_KEY=
SUPABASE_DB_PASSWORD=
ENABLE_SUPABASE_SYNC=false

# -----------------------------------------------------------------------------
# BLOCKCHAIN / ECOCOIN  (out of current scope - off by default, honest stubs)
# -----------------------------------------------------------------------------
ENABLE_BLOCKCHAIN=false
BLOCKCHAIN_MODE=simulation
# 🔑 No page exists: BLOCKCHAIN_PRIVATE_KEY comes from your own wallet - keep it
#    offline, never commit. Web3 RPC/API keys (free tiers):
#    🔑 Alchemy:      https://dashboard.alchemy.com/
#    🔑 Polygonscan:  https://polygonscan.com/myapikey
#    🔑 Testnet faucet: https://faucet.polygon.technology/
BLOCKCHAIN_PRIVATE_KEY=
BLOCKCHAIN_WALLET_ADDRESS=
ECO_TOKEN_CONTRACT_ADDRESS=
ALCHEMY_API_KEY=
POLYGONSCAN_API_KEY=
LOCAL_RPC_URL=
POLYGON_RPC_URL=
POLYGON_AMOY_RPC_URL=

# -----------------------------------------------------------------------------
# PAYMENTS  (optional)
# -----------------------------------------------------------------------------
# 🔑 Zarinpal merchant panel (requires business verification): https://next.zarinpal.com/
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
BANK_TRANSFER_SHEBA=
BANK_TRANSFER_CARD_NUMBER=
BANK_TRANSFER_HOLDER=

# -----------------------------------------------------------------------------
# EMAIL / STORAGE  (optional)
# -----------------------------------------------------------------------------
SMTP_PASSWORD=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=

# -----------------------------------------------------------------------------
# INTEGRATION / AUTOMATION  (optional)
# -----------------------------------------------------------------------------
AGENT_TOKEN=                       # automation router token
API_BASE_URL=
PUBLIC_BASE_URL=
TRUSTED_DOMAINS=
REDIS_URL=                         # empty = in-memory rate limiting
NATS_URL=nats://localhost:4222
ECO_RUN_NATS_INTEGRATION=false

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_SIMULATED_DATA=false
ENABLE_MARKETPLACE=true
ENABLE_DEBUG_ROUTES=false
ENABLE_CROP_RECOMMENDER=true
# int flag (not bool): 1 = allow DB seeding, 0 = refuse. Default is 1.
ECO_NOJIN_ALLOW_SEED=0
