# Copy to .env and fill in real values. Never commit .env.
# Phase 0: all runtime config now flows through pydantic-settings.

# --- Environment ---
ENVIRONMENT=development          # development | testing | production
DEBUG=false
LOG_LEVEL=INFO

# --- Security: GENERATE a strong key in production ---
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-insecure-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200
# Shared secret for USSD/SMS/Voice telco webhooks (empty = disabled in dev)
TELCO_WEBHOOK_KEY=

# --- CORS: explicit origins, never * with credentials in production ---
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
ALLOW_CREDENTIALS=true

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
# SQLite (default):  sqlite:///./data/econojin.db
# PostGIS (docker):  postgresql+psycopg://eco_nojin:YOUR_PASSWORD@localhost:5432/eco_nojin
DATABASE_URL=sqlite:///./data/econojin.db
REDIS_URL=redis://localhost:6379/0

# --- External integrations ---
# Sentinel-2 / Planetary Computer (empty = simulated data until W-001 staged)
SATELLITE_API_KEY=
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api

# --- Postgres (used by docker-compose) ---
POSTGRES_USER=eco_nojin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eco_nojin
