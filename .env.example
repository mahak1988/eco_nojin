# =============================================================================
# eco_nojin .env.example
# =============================================================================
# This file documents all required environment variables.
# Copy this file to .env and fill in real values for each variable.
#
# IMPORTANT: Never commit .env to version control.
# =============================================================================

# --- Environment ---
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Security ---
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_MINUTES=43200
TELCO_WEBHOOK_KEY=

# --- CORS ---
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:5173","http://localhost:5173"]
ALLOW_CREDENTIALS=true

# --- Rate Limiting ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# --- Database ---
DATABASE_URL=sqlite:///./data/econojin.db
REDIS_URL=redis://localhost:6379/0

# --- External Integrations ---
SATELLITE_API_KEY=
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api

# --- Postgres (docker) ---
POSTGRES_USER=eco_nojin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eco_nojin

# --- Telegram Bot ---
BOT_TOKEN=CHANGE_ME
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Phase 2: Multi-platform ---
EITAA_TOKEN=
EITAA_ENABLED=false
BALE_TOKEN=
BALE_ENABLED=false
RUBIKA_TOKEN=
RUBIKA_ENABLED=false

# --- Phase 4: Copernicus ---
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_BASE_URL=https://catalogue.dataspace.copernicus.eu
CDSE_IDENTITY_URL=https://identity.dataspace.copernicus.eu
CDSE_USERNAME=
CDSE_PASSWORD=

CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_UID=
CDS_API_KEY=CHANGE_ME
EWDS_API_URL=https://ewds.climate.copernicus.eu/api
EWDS_UID=
EWDS_API_KEY=CHANGE_ME
ADS_API_URL=https://ads.atmosphere.copernicus.eu/api
ADS_UID=
ADS_API_KEY=CHANGE_ME
SEPAL_BASE_URL=https://sepal.io

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=

# --- AI Services ---
GROQ_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=

# --- Blockchain (Polygon) ---
ALCHEMY_API_KEY=
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_RPC_URL=https://polygon-rpc.com
BLOCKCHAIN_WALLET_ADDRESS=

# --- Cloudflare R2 ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=econojin-assets

# --- Copernicus (aliases) ---
COPERNICUS_CDS_API_KEY=CHANGE_ME
COPERNICUS_ADS_API_KEY=CHANGE_ME
COPERNICUS_EWDS_API_KEY=CHANGE_ME
COPERNICUS_CDS_URL=https://cds.climate.copernicus.eu/api
COPERNICUS_ADS_URL=https://ads.atmosphere.copernicus.eu/api
COPERNICUS_EWDS_URL=https://ewds.climate.copernicus.eu/api

# --- Telegram Bot (alias) ---
TELEGRAM_BOT_TOKEN=CHANGE_ME
BOT_API_BASE_URL=http://127.0.0.1:8000
BOT_RATE_LIMIT=10
BOT_REQUEST_TIMEOUT=60.0
BOT_LOG_LEVEL=INFO

# --- Blockchain (additional) ---
PRIVATE_KEY=CHANGE_ME
MUMBAI_RPC_URL=https://rpc-mumbai.maticvigil.com
POLYGONSCAN_API_KEY=

# --- KoboToolbox ---
KOBO_TOKEN=
KOBO_FORM_ID=

ECO_NOJIN_ALLOW_SEED=1

# --- Local AI ---
AI_LLM_KEY=ollama-local
AI_LLM_URL=http://127.0.0.1:11434/v1
AI_LLM_MODEL=qwen3:4b

MANUAL_DATA_DB=./data/manual/eco_manual_v1.sqlite
