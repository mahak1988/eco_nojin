# ============================================================================
# Eco Nojin .env.example — Cloud-Native, Free Tier Only
# Copy to .env and fill in your API keys
# ============================================================================

# ============================================================================
# APPLICATION CORE
# ============================================================================
APP_NAME=Eco Nojin
APP_ENV=development          # development, production, staging, test
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=dev-secret-key-change-in-production
PROJECT_NAME=Eco Nojin
ENVIRONMENT=development
DEBUG=true
API_VERSION=0.1.0

# ============================================================================
# DATABASE (PostgreSQL via Supabase)
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/econojin
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-access-token

# ============================================================================
# LLM Providers (OpenAI-compatible, free tiers)
# Get keys from: console.groq.com, openrouter.ai, aistudio.google.com, console.mistral.ai, platform.deepseek.com
# ============================================================================
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# ============================================================================
# Embedding Providers
# Get keys from: jina.ai, dash.cloudflare.com, dashboard.cohere.ai
# ============================================================================
JINA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
COHERE_API_KEY=

# ============================================================================
# Vector Store (Qdrant Cloud Free: cloud.qdrant.io)
# ============================================================================
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=

# ============================================================================
# CORS & SECURITY
# ============================================================================
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]
SECRET_KEY=dev-secret-key-change-in-production
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080
JWT_REFRESH_EXPIRATION_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=50

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_DEBUG_ROUTES=false
ENABLE_SATELLITE_REAL=true
ENABLE_AI_ASSISTANT=true
ENABLE_MARKETPLACE=true
ENABLE_SIMULATED_DATA=false
ENABLE_BLOCKCHAIN=false
ENABLE_REALTIME_SSE=true
ENABLE_SUPABASE_SYNC=false
ENABLE_EVENT_BUS=false

# ============================================================================
# I18N (14 Languages)
# ============================================================================
DEFAULT_LANGUAGE=fa
SUPPORTED_LANGUAGES=fa,en,ar,tr,ur,ps,de,es,fr,hi,pt,zh,ms,it,bn
RTL_LANGUAGES=fa,ar,ur,ps,he

# ============================================================================
# EXTERNAL APIs (Free, no key required)
# ============================================================================
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
CDSE_BASE_URL=https://catalogue.dataspace.copernicus.eu
CDSE_IDENTITY_URL=https://identity.dataspace.copernicus.eu
PLANETARY_COMPUTER_API_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Copernicus (optional - register at cds.climate.copernicus.eu for free)
CDS_API_KEY=
CDS_UID=
CDS_API_URL=https://cds.climate.copernicus.eu/api
EWDS_API_KEY=
EWDS_UID=
EWDS_API_URL=https://ewds.climate.copernicus.eu/api
ADS_API_KEY=
ADS_UID=
ADS_API_URL=https://ads.atmosphere.copernicus.eu/api

# ============================================================================
# LOGGING & MONITORING
# ============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/econojin.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ============================================================================
# REDIS (Optional - for rate limiting)
# ============================================================================
REDIS_URL=

# ============================================================================
# NATS (Optional - Event Bus)
# ============================================================================
NATS_URL=nats://localhost:4222

# ============================================================================
# TELEGRAM BOT (Optional)
# ============================================================================
TELEGRAM_BOT_TOKEN=
BOT_TOKEN=
BOT_API_BASE_URL=http://localhost:8000
BOT_RATE_LIMIT=10
BOT_REQUEST_TIMEOUT=60.0
BOT_LOG_LEVEL=INFO
BOT_DEFAULT_LANGUAGE=fa

# ============================================================================
# FRONTEND / PUBLIC URLS
# ============================================================================
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000