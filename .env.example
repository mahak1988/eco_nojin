# =============================================================================
# eco_nojin .env.example — COMPREHENSIVE
# =============================================================================
# This file documents ALL environment variables used by the application.
# Copy this file to .env and fill in real values for each variable.
#
# IMPORTANT: Never commit .env to version control (already in .gitignore).
# All secrets (private keys, passwords, tokens) MUST only exist in .env
# =============================================================================

# =============================================================================
# APPLICATION CORE
# =============================================================================
APP_NAME=Eco Nojin
APP_ENV=development          # development, production, staging, test
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY
PROJECT_NAME=Eco Nojin
ENVIRONMENT=development      # development, production, staging, test
DEBUG=false
API_VERSION=0.1.0
ENGINE_NAME=hydroma

# =============================================================================
# SECURITY & AUTHENTICATION (JWT)
# =============================================================================
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_KEY_64_CHARS_MIN
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_KEY_64_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=10080
JWT_REFRESH_EXPIRATION_DAYS=30
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=43200
API_KEY_HEADER=X-API-Key
TELCO_WEBHOOK_KEY=

# =============================================================================
# CORS & SECURITY
# =============================================================================
CORS_ORIGINS=["http://127.0.0.1:3000","http://localhost:3000","http://127.0.0.1:5173","http://localhost:5173","http://127.0.0.1:4173","http://localhost:4173"]
ALLOW_CREDENTIALS=true
CORS_ALLOW_CREDENTIALS=true

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_BURST=50
ECONOJIN_RATELIMIT_PER_MINUTE=240

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=sqlite:///./data/econojin.db
# PostgreSQL (production): postgresql://user:password@localhost:5432/econojin
POSTGRES_USER=eco_nojin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=eco_nojin
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# RBAC & I18N
# =============================================================================
DEFAULT_USER_ROLE=farmer
ALLOWED_ROLES=farmer,advisor,admin,researcher,organization,tourist
DEFAULT_LANGUAGE=fa
SUPPORTED_LANGUAGES=fa,en,ar,tr,ur,ps
RTL_LANGUAGES=fa,ar,ur,ps,he

# =============================================================================
# FILE UPLOAD & STORAGE
# =============================================================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
AVATAR_MAX_SIZE_KB=500

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@econojin.com
SMTP_FROM_NAME=Eco Nojin

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/econojin.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_DEBUG_ROUTES=false
ENABLE_SATELLITE_REAL=true
ENABLE_AI_ASSISTANT=true
ENABLE_MARKETPLACE=true
ENABLE_SIMULATED_DATA=true
ENABLE_BLOCKCHAIN=false
ENABLE_REALTIME_SSE=true
ENABLE_SUPABASE_SYNC=true

# =============================================================================
# SUPABASE (Database & Auth)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# =============================================================================
