{
  "AGR001": {
    "name": "زراعت عمومی",
    "indicators": [
      {
        "id": "AGR001_IND01",
        "name": "عملکرد محصول",
        "symbol": "Y",
        "unit": "تن/هکتار",
        "formula": "Y = Biomass × Harvest_Index",
        "reference": "FAO AquaCrop Manual",
        "threshold": {
          "min": 0.5,
          "optimal": 4.0,
          "max": 15.0
        }
      },
      {
        "id": "AGR001_IND02",
        "name": "شاخص برداشت",
        "symbol": "HI",
        "unit": "بدون بعد",
        "formula": "HI = Yield / Biomass",
        "reference": "FAO Irrigation Paper 66",
        "threshold": {
          "min": 0.2,
          "optimal": 0.45,
          "max": 0.6
        }
      },
      {
        "id": "AGR001_IND03",
        "name": "کارایی مصرف آب",
        "symbol": "WUE",
        "unit": "کیلوگرم/متر مکعب",
        "formula": "WUE = Yield / Total_Water_Used",
        "reference": "FAO Water Productivity",
        "threshold": {
          "min": 0.5,
          "optimal": 1.5,
          "max": 3.0
        }
      },
      {
        "id": "AGR001_IND04",
        "name": "شاخص سطح برگ",
        "symbol": "LAI",
        "unit": "متر مربع/متر مربع",
        "formula": "LAI = Leaf_Area / Ground_Area",
        "reference": "Chen & Black 1992",
        "threshold": {
          "min": 0.5,
          "optimal": 4.0,
          "max": 8.0
        }
      },
      {
        "id": "AGR001_IND05",
        "name": "پوشش گیاهی",
        "symbol": "CC",
        "unit": "درصد",
        "formula": "CC = Canopy_Cover × 100",
        "reference": "FAO AquaCrop",
        "threshold": {
          "min": 10,
          "optimal": 90,
          "max": 100
        }
      }
    ],
    "formulas": {
      "biomass_accumulation": {
        "name": "انباشت بیوماس",
        "formula": "B(t) = ∫[WP × Tr(t)] dt",
        "parameters": {
          "WP": "بهره‌وری آب (g/m²/mm)",
          "Tr": "تعرق روزانه (mm)",
          "t": "زمان (روز)"
        }
      },
      "yield_formation": {
        "name": "تشکیل عملکرد",
        "formula": "Y = B × HI × Ks_water × Ks_temp",
        "parameters": {
          "B": "بیوماس نهایی",
          "HI": "شاخص برداشت",
          "Ks_water": "ضریب تنش آبی",
          "Ks_temp": "ضریب تنش حرارتی"
        }
      },
      "water_productivity": {
        "name": "بهره‌وری آب",
        "formula": "WP = B / ∑Tr",
        "parameters": {
          "B": "بیوماس (g/m²)",
          "Tr": "تعرق تجمعی (mm)"
        }
      }
    },
    "standards": {
      "FAO_AquaCrop": {
        "source": "FAO Irrigation and Drainage Paper 66",
        "year": 2012,
        "parameters": [
          "Kc",
          "WP",
          "HI",
          "CC",
          "Root_Depth"
        ]
      },
      "ISO_11074": {
        "source": "ISO 11074 Soil Quality Vocabulary",
        "year": 2015,
        "parameters": [
          "Soil_Quality",
          "Fertility"
        ]
      }
    },
    "hydroma_role": {
      "algorithms": [
        "H01",
        "H05",
        "H09",
        "H18"
      ],
      "inputs": [
        "عملکرد مورد انتظار",
        "شاخص برداشت",
        "بهره‌وری آب"
      ],
      "outputs": [
        "عملکرد پیش‌بینی‌شده",
        "کارایی مصرف آب"
      ],
      "calibration": "تنظیم ضرایب گیاهی بر اساس داده‌های محلی",
      "validation": "مقایسه با آمار واقعی عملکرد"
    }
  },
  "AGR009": {
    "name": "فیزیولوژی گیاهی",
    "indicators": [
      {
        "id": "AGR009_IND01",
        "name": "نرخ فتوسنتز خالص",
        "symbol": "Pn",
        "unit": "μmol CO₂/m²/s",
        "formula": "Pn = GPP - R_leaf",
        "reference": "Larcher 2003",
        "threshold": {
          "min": 5,
          "optimal": 25,
          "max": 40
        }
      },
      {
        "id": "AGR009_IND02",
        "name": "تعرق",
        "symbol": "Tr",
        "unit": "mm/day",
        "formula": "Tr = ETc × (CC/CC_max)",
        "reference": "FAO AquaCrop",
        "threshold": {
          "min": 0.5,
          "optimal": 5.0,
          "max": 10.0
        }
      },
      {
        "id": "AGR009_IND03",
        "name": "هدایت روزنه‌ای",
        "symbol": "gs",
        "unit": "mol H₂O/m²/s",
        "formula": "gs = f(VPD, CO₂, Light, Soil_Water)",
        "reference": "Ball-Berry Model",
        "threshold": {
          "min": 0.05,
          "optimal": 0.3,
          "max": 0.8
        }
      },
      {
        "id": "AGR009_IND04",
        "name": "پتانسیل آب برگ",
        "symbol": "Ψ_leaf",
        "unit": "MPa",
        "formula": "Ψ_leaf = Ψ_soil - Ψ_resistance",
        "reference": "Plant Water Relations",
        "threshold": {
          "min": -3.0,
          "optimal": -0.5,
          "max": 0
        }
      },
      {
        "id": "AGR009_IND05",
        "name": "کارایی مصرف نور",
        "symbol": "LUE",
        "unit": "g C/MJ PAR",
        "formula": "LUE = GPP / APAR",
        "reference": "Monteith 1972",
        "threshold": {
          "min": 0.5,
          "optimal": 1.5,
          "max": 3.0
        }
      }
    ],
    "formulas": {
      "stomatal_conductance": {
        "name": "هدایت روزنه‌ای (مدل Ball-Berry)",
        "formula": "gs = g₀ + g₁ × (A × RH) / (C_s × VPD)",
        "parameters": {
          "g₀": "هدایت پایه روزنه",
          "g₁": "ضریب حساسیت",
          "A": "نرخ فتوسنتز",
          "RH": "رطوبت نسبی",
          "C_s": "غلظت CO₂ سطح برگ",
          "VPD": "کسری فشار بخار"
        }
      },
      "photosynthesis_response": {
        "name": "پاسخ فتوسنتز به نور",
        "formula": "Pn = Pmax × (1 - exp(-α × PAR / Pmax)) - Rd",
        "parameters": {
          "Pmax": "حداکثر فتوسنتز",
          "α": "کارایی کوانتومی",
          "PAR": "تابش فعال فتوسنتزی",
          "Rd": "تنفس تاریکی"
        }
      },
      "temperature_response": {
        "name": "پاسخ به دما",
        "formula": "f(T) = (T - Tmin) × (Tmax - T) / (Topt - Tmin) / (Tmax - Topt)",
        "parameters": {
          "Tmin": "دمای حداقل",
          "Topt": "دمای بهینه",
          "Tmax": "دمای حداکثر"
        }
      }
    },
    "standards": {
      "FAO_AquaCrop_Kc": {
        "source": "FAO Irrigation Paper 66",
        "year": 2012,
        "parameters": [
          "Kc_max",
          "Kc_min",
          "Kc_seedling"
        ]
      },
      "Larcher_Plant_Ecophysiology": {
        "source": "Larcher, Physiological Plant Ecology",
        "year": 2003,
        "parameters": [
          "Photosynthesis",
          "Transpiration",
          "Water_Potential"
        ]
      }
    },
    "hydroma_role": {
      "algorithms": [
        "H02",
        "H04",
        "H09"
      ],
      "inputs": [
        "دما",
        "رطوبت",
        "نور",
        "وضعیت آب خاک"
      ],
      "outputs": [
        "ضرایب تنش",
        "تعرق پتانسیل",
        "فتوسنتز"
      ],
      "calibration": "تنظیم ضرایب پاسخ به تنش",
      "validation": "مقایسه با اندازه‌گیری‌های میدانی"
    }
  },
  "WAS011": {
    "name": "فیزیک خاک",
    "indicators": [
      {
        "id": "WAS011_IND01",
        "name": "ظرفیت نگهداری آب قابل دسترس",
        "symbol": "AWC",
        "unit": "mm/m",
        "formula": "AWC = (θ_fc - θ_wilt) × Depth",
        "reference": "FAO HWSD",
        "threshold": {
          "min": 50,
          "optimal": 150,
          "max": 250
        }
      },
      {
        "id": "WAS011_IND02",
        "name": "هدایت هیدرولیکی اشباع",
        "symbol": "Ksat",
        "unit": "mm/h",
        "formula": "Ksat = f(texture, structure, porosity)",
        "reference": "Saxton & Rawls 2006",
        "threshold": {
          "min": 1,
          "optimal": 20,
          "max": 100
        }
      },
      {
        "id": "WAS011_IND03",
        "name": "چگالی ظاهری",
        "symbol": "BD",
        "unit": "g/cm³",
        "formula": "BD = Mass_Dry / Volume_Total",
        "reference": "Blake & Hartge 1986",
        "threshold": {
          "min": 1.0,
          "optimal": 1.3,
          "max": 1.8
        }
      },
      {
        "id": "WAS011_IND04",
        "name": "تخلخل کل",
        "symbol": "φ",
        "unit": "درصد",
        "formula": "φ = (1 - BD/ρ_particle) × 100",
        "reference": "Soil Physics",
        "threshold": {
          "min": 30,
          "optimal": 50,
          "max": 65
        }
      },
      {
        "id": "WAS011_IND05",
        "name": "منحنی مشخصه رطوبت خاک",
        "symbol": "SWRC",
        "unit": "-",
        "formula": "θ(Ψ) = θ_r + (θ_s - θ_r) / [1 + (α|Ψ|)^n]^m",
        "reference": "van Genuchten 1980",
        "threshold": {
          "min": 0,
          "optimal": 0.3,
          "max": 0.6
        }
      }
    ],
    "formulas": {
      "van_genuchten": {
        "name": "مدل ون گنوختن (منحنی مشخصه رطوبت)",
        "formula": "θ(Ψ) = θ_r + (θ_s - θ_r) / [1 + (α|Ψ|)^n]^(1-1/n)",
        "parameters": {
          "θ_r": "رطوبت باقیمانده",
          "θ_s": "رطوبت اشباع",
          "α": "پارامتر شکل",
          "n": "پارامتر اندازه توزیع حفرات",
          "Ψ": "پتانسیل ماتریک"
        }
      },
      "darcy_flow": {
        "name": "قانون دارسی",
        "formula": "q = -K(θ) × dH/dz",
        "parameters": {
          "q": "چگالی شار آب",
          "K(θ)": "هدایت هیدرولیکی غیراشباع",
          "H": "بار هیدرولیکی",
          "z": "عمق"
        }
      },
      "richards_equation": {
        "name": "معادله ریچاردز",
        "formula": "∂θ/∂t = ∂/∂z[K(θ)(∂Ψ/∂z + 1)] - S",
        "parameters": {
          "θ": "رطوبت حجمی",
          "t": "زمان",
          "K(θ)": "هدایت هیدرولیکی",
          "Ψ": "پتانسیل ماتریک",
          "S": "جذب ریشه"
        }
      }
    },
    "standards": {
      "FAO_HWSD": {
        "source": "FAO Harmonized World Soil Database",
        "year": 2012,
        "parameters": [
          "AWC",
          "Texture",
          "Depth"
        ]
      },
      "USDA_Soil_Taxonomy": {
        "source": "USDA Soil Survey Staff",
        "year": 2014,
        "parameters": [
          "Texture_Class",
          "Ksat",
          "BD"
        ]
      }
    },
    "hydroma_role": {
      "algorithms": [
        "H09",
        "H10",
        "H12"
      ],
      "inputs": [
        "بافت خاک",
        "عمق",
        "ماده آلی",
        "چگالی ظاهری"
      ],
      "outputs": [
        "ظرفیت آب پویا",
        "هدایت هیدرولیکی",
        "پارامترهای حرکت آب"
      ],
      "calibration": "تنظیم پارامترهای ون گنوختن بر اساس داده‌های محلی",
      "validation": "مقایسه با اندازه‌گیری‌های میدانی رطوبت"
    }
  },
  "WAS018": {
    "name": "شوری خاک",
    "indicators": [
      {
        "id": "WAS018_IND01",
        "name": "هدایت الکتریکی",
        "symbol": "EC",
        "unit": "dS/m",
        "formula": "EC = f(salt_concentration)",
        "reference": "USDA Salinity Handbook 60",
        "threshold": {
          "min": 0,
          "optimal": 1.0,
          "max": 16.0
        }
      },
      {
        "id": "WAS018_IND02",
        "name": "نسبت جذب سدیم",
        "symbol": "SAR",
        "unit": "بدون بعد",
        "formula": "SAR = Na⁺ / √((Ca²⁺ + Mg²⁺)/2)",
        "reference": "Richards 1954",
        "threshold": {
          "min": 0,
          "optimal": 5,
          "max": 30
        }
      },
      {
        "id": "WAS018_IND03",
        "name": "درصد سدیم تبادلی",
        "symbol": "ESP",
        "unit": "درصد",
        "formula": "ESP = (Exch_Na / CEC) × 100",
        "reference": "USDA Handbook 60",
        "threshold": {
          "min": 0,
          "optimal": 5,
          "max": 15
        }
      },
      {
        "id": "WAS018_IND04",
        "name": "پتانسیل اسمزی",
        "symbol": "Ψ_osmotic",
        "unit": "MPa",
        "formula": "Ψ_osmotic = -0.036 × EC",
        "reference": "Soil Physics",
        "threshold": {
          "min": -0.6,
          "optimal": -0.03,
          "max": 0
        }
      },
      {
        "id": "WAS018_IND05",
        "name": "کسر آبشویی مورد نیاز",
        "symbol": "LR",
        "unit": "درصد",
        "formula": "LR = EC_iw / (5 × EC_e - EC_iw)",
        "reference": "Ayers & Westcot 1985",
        "threshold": {
          "min": 5,
          "optimal": 15,
          "max": 40
        }
      }
    ],
    "formulas": {
      "leaching_requirement": {
        "name": "نیاز آبشویی",
        "formula": "LR = EC_iw / (5 × EC_e - EC_iw)",
        "parameters": {
          "EC_iw": "شوری آب آبیاری",
          "EC_e": "شوری مورد تحمل گیاه"
        }
      },
      "salt_balance": {
        "name": "بالانس نمک",
        "formula": "ΔSalt = (Irrigation × EC_iw) - (Drainage × EC_dr) - (Uptake)",
        "parameters": {
          "Irrigation": "مقدار آبیاری",
          "EC_iw": "شوری آب آبیاری",
          "Drainage": "مقدار زهکشی",
          "EC_dr": "شوری آب زهکشی"
        }
      },
      "crop_tolerance": {
        "name": "تحمل گیاه به شوری",
        "formula": "Y/Ymax = 1 - b × (EC_e - a) (برای EC > a)",
        "parameters": {
          "Y": "عملکرد تحت تنش",
          "Ymax": "عملکرد حداکثر",
          "a": "آستانه تحمل",
          "b": "شیب کاهش عملکرد",
          "EC_e": "شوری منطقه ریشه"
        }
      }
    },
    "standards": {
      "USDA_Handbook_60": {
        "source": "USDA Agriculture Handbook 60",
        "year": 1954,
        "parameters": [
          "EC",
          "SAR",
          "ESP",
          "Classification"
        ]
      },
      "FAO_AquaCrop_Salinity": {
        "source": "FAO AquaCrop Salinity Module",
        "year": 2012,
        "parameters": [
          "Ks_salinity",
          "EC_threshold",
          "EC_slope"
        ]
      }
    },
    "hydroma_role": {
      "algorithms": [
        "H11"
      ],
      "inputs": [
        "شوری اولیه",
        "کیفیت آب آبیاری",
        "کسر آبشویی",
        "تحمل گیاه"
      ],
      "outputs": [
        "پیش‌بینی شوری",
        "نیاز آبشویی",
        "تأثیر بر عملکرد"
      ],
      "calibration": "تنظیم ضرایب تحمل شوری بر اساس ارقام محلی",
      "validation": "مقایسه با داده‌های پایش شوری"
    }
  },
  "CLI012": {
    "name": "اقلیم‌شناسی بیابان",
    "indicators": [
      {
        "id": "CLI012_IND01",
        "name": "شاخص خشکی",
        "symbol": "AI",
        "unit": "بدون بعد",
        "formula": "AI = P / PET",
        "reference": "UNEP 1992",
        "threshold": {
          "min": 0.05,
          "optimal": 0.2,
          "max": 0.65
        }
      },
      {
        "id": "CLI012_IND02",
        "name": "تبخیر و تعرق پتانسیل",
        "symbol": "PET",
        "unit": "mm/year",
        "formula": "PET = f(T, RH, Wind, Radiation)",
        "reference": "FAO Penman-Monteith",
        "threshold": {
          "min": 1000,
          "optimal": 2000,
          "max": 4000
        }
      },
      {
        "id": "CLI012_IND03",
        "name": "ضریب تغییرات بارش",
        "symbol": "CV_rain",
        "unit": "بدون بعد",
        "formula": "CV = σ_rain / μ_rain",
        "reference": "Statistical Hydrology",
        "threshold": {
          "min": 0.1,
          "optimal": 0.3,
          "max": 0.7
        }
      },
      {
        "id": "CLI012_IND04",
        "name": "دمای سطح زمین",
        "symbol": "LST",
        "unit": "°C",
        "formula": "LST = f(Albedo, NDVI, T_air)",
        "reference": "Remote Sensing",
        "threshold": {
          "min": 10,
          "optimal": 30,
          "max": 60
        }
      },
      {
        "id": "CLI012_IND05",
        "name": "باد فرساینده",
        "symbol": "Wind_Erosion_Risk",
        "unit": "درصد روزها",
        "formula": "Risk = Days(Wind > Threshold) / 365",
        "reference": "Wind Erosion Models",
        "threshold": {
          "min": 0,
          "optimal": 10,
          "max": 50
        }
      }
    ],
    "formulas": {
      "aridity_index": {
        "name": "شاخص خشکی UNEP",
        "formula": "AI = P / PET",
        "parameters": {
          "P": "بارش سالانه",
          "PET": "تبخیر و تعرق پتانسیل سالانه"
        },
        "classification": {
          "Hyper-arid": "AI < 0.05",
          "Arid": "0.05 ≤ AI < 0.20",
          "Semi-arid": "0.20 ≤ AI < 0.50",
          "Dry sub-humid": "0.50 ≤ AI < 0.65"
        }
      },
      "penman_monteith": {
        "name": "معادله پنمن-مونتیث (تبخیر مرجع)",
        "formula": "ET₀ = [0.408Δ(Rn-G) + γ(900/(T+273))u₂(e_s-e_a)] / [Δ + γ(1+0.34u₂)]",
        "parameters": {
          "Δ": "شیب منحنی فشار بخار",
          "Rn": "تابش خالص",
          "G": "شار حرارتی خاک",
          "γ": "ثابت سایکرومتریک",
          "T": "دمای هوا",
          "u₂": "سرعت باد در ۲ متری",
          "e_s": "فشار بخار اشباع",
          "e_a": "فشار بخار واقعی"
        }
      }
    },
    "standards": {
      "UNEP_Aridity_Index": {
        "source": "UNEP World Atlas of Desertification",
        "year": 1992,
        "parameters": [
          "AI",
          "Classification"
        ]
      },
      "FAO_Penman_Monteith": {
        "source": "FAO Irrigation Paper 56",
        "year": 1998,
        "parameters": [
          "ET₀",
          "Kc"
        ]
      }
    },
    "hydroma_role": {
      "algorithms": [
        "H01",
        "H02",
        "H04",
        "H06"
      ],
      "inputs": [
        "بارش",
        "دما",
        "رطوبت",
        "باد",
        "تابش"
      ],
      "outputs": [
        "شاخص خشکی",
        "تبخیر مرجع",
        "ریسک خشکسالی"
      ],
      "calibration": "تنظیم ضرایب اقلیمی بر اساس داده‌های محلی",
      "validation": "مقایسه با ایستگاه‌های هواشناسی"
    }
  },
  "GOV010": {
    "name": "بیابان‌زدایی",
    "indicators": [
      {
        "id": "GOV010_IND01",
        "name": "شاخص تخریب زمین",
        "symbol": "LDI",
        "unit": "بدون بعد (۰-۱)",
        "formula": "LDI = w₁×Vegetation + w₂×Soil + w₃×Water + w₄×Climate",
        "reference": "UNCCD LDN",
        "threshold": {
          "min": 0,
          "optimal": 0.2,
          "max": 1.0
        }
      },
